APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

BUSINESS_TIMEZONE=Africa/Cairo

APP_MIN_SUPPORTED_VERSION_ANDROID=
APP_MIN_SUPPORTED_VERSION_IOS=
APP_LATEST_VERSION_ANDROID=
APP_LATEST_VERSION_IOS=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily_json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tayari_eg
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=local
QUEUE_CONNECTION=database
# Scheduler runs queue:work every minute on the shared host; set to false when Horizon runs the workers
QUEUE_WORK_FROM_SCHEDULER=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum SPA cookie auth for the React frontend (Flutter uses Bearer tokens)
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Comma-separated list of allowed CORS origins, e.g. https://tayari.eg,https://admin.tayari.eg
FRONTEND_URL=http://localhost:3000

SENTRY_LARAVEL_DSN=

# Comma-separated emails allowed to open /docs/api outside local
API_DOCS_ALLOWED_EMAILS=

# When false, register sends no OTP and login/client routes don't need a verified phone
REQUIRE_PHONE_VERIFICATION=true
LOGIN_ATTEMPTS_PER_MINUTE=5
LOGIN_ATTEMPTS_PER_PHONE_PER_HOUR=20

OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_DECAY_MINUTES=60
OTP_RATE_LIMIT_PER_PHONE=5
OTP_RATE_LIMIT_PER_IP=20

# Only "log" for now (full message in local/testing, [redacted] elsewhere)
SMS_DRIVER=log

# Absolute path to the Firebase service account JSON, kept outside the project.
# Empty or a missing file: pushes are skipped with a warning in the log, nothing is sent.
FIREBASE_CREDENTIALS=

MEDIA_PRIVATE_DISK=local
# Public files such as category icons; needs php artisan storage:link
MEDIA_PUBLIC_DISK=public
MEDIA_SIGNED_URL_MINUTES=5
MEDIA_MAX_UPLOAD_KB=5120

# Tayars: location updates per minute per tayar, minutes without a location before a tayar is set offline,
# the default nearest-tayar search radius, the wait before a rejected applicant may change the application,
# and the smallest and largest radius a tayar may pick in the zone mode
TAYAR_LOCATION_UPDATES_PER_MINUTE=20
TAYAR_OFFLINE_AFTER_MINUTES=5
TAYAR_NEAREST_RADIUS_KM=5
TAYAR_REAPPLY_AFTER_HOURS=24
TAYAR_ZONE_MIN_RADIUS_KM=1
TAYAR_ZONE_MAX_RADIUS_KM=15

# Orders: straight-line distance times this multiplier approximates the road, the longest trip priced in the
# zone mode and the longest order allowed (road km), and the shortest order allowed (straight-line km)
ORDER_ROAD_DISTANCE_MULTIPLIER=1.30
ORDER_ZONE_MAX_DISTANCE_KM=15
ORDER_MAX_DISTANCE_KM=1200
ORDER_MIN_DISTANCE_KM=0.1

# Matching: offers per round, how long an offer lasts (seconds), the search radius around the pickup (first, added per
# round, largest; km), when an order nobody accepted is cancelled (minutes after the price was accepted), how far a
# long-distance drop-off may be from the tayar's destination (km), how many accepted orders a tayar may hold, how long
# after the accept the sender cancels for free (seconds), and the fee (EGP) the sender owes the tayar for a later cancel
MATCHING_OFFERS_PER_ROUND=5
MATCHING_OFFER_TIMEOUT_SECONDS=60
MATCHING_FIRST_RADIUS_KM=3
MATCHING_RADIUS_STEP_KM=3
MATCHING_MAX_RADIUS_KM=10
MATCHING_SEARCH_TIMEOUT_MINUTES=15
MATCHING_DESTINATION_RADIUS_KM=20
MATCHING_MAX_ACTIVE_ORDERS=1
MATCHING_MAX_ACTIVE_ORDERS_LONG_DISTANCE=5
MATCHING_FREE_CANCEL_SECONDS=120
MATCHING_CANCEL_FEE=20.00

# Tracking: the receiver's tracking page on the website ({token} is replaced), the delivery and refusal code length,
# wrong codes before they lock, how long codes last (hours), code resends per order per hour, tracking page requests
# per IP per minute, and code entries per tayar per minute
TRACKING_URL=http://localhost:3000/track/{token}
TRACKING_CODE_LENGTH=6
TRACKING_CODE_MAX_ATTEMPTS=5
TRACKING_CODES_VALID_HOURS=24
TRACKING_RESEND_CODES_PER_HOUR=3
TRACKING_REQUESTS_PER_MINUTE=30
TRACKING_CODE_REQUESTS_PER_MINUTE=10

# First super admin, created by php artisan db:seed
SUPER_ADMIN_NAME=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# Password of every demo account, only for php artisan db:seed --class=DemoDataSeeder (empty: the seeder refuses to run)
DEMO_USERS_PASSWORD=
